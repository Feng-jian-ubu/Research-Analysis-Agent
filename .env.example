# Required: OpenAI-compatible LLM configuration
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=replace-with-your-model-name

# Optional: leave empty when using the default OpenAI API endpoint
LLM_BASE_URL=

# Optional: comma-separated frontend origins allowed by CORS
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
